# Copy to .env for local development. Never commit the real .env file.
# See DEPLOYMENT.md for how these map to AWS Secrets Manager in deployed environments.

# CockroachDB connection string (local single-node dev instance — see CONTRIBUTING.md)
DATABASE_URL=postgresql://root@localhost:26257/continuum?sslmode=disable

# Bedrock embedding model used for the semantic tier (must match the dimension in
# the semantic_memory schema — SRS.md §6)
MCP_CONTINUUM_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# Per-query SQL timeout in seconds (SECURITY.md — bounds a slow/malicious query)
MCP_CONTINUUM_COMMAND_TIMEOUT_SECONDS=30
